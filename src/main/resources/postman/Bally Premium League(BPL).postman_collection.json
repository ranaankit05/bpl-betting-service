{
	"info": {
		"_postman_id": "93362bf1-63f1-4816-9f1f-a161a937e1ec",
		"name": "Bally Premium League(BPL)",
		"description": "Postman collection for the Bally Premium League match betting service.\n\nEVERYTHING is driven by the 'BPL Local' environment: paths, API keys, user ids, team ids/names, match name, statuses and scores. Select that environment, then run folders 01 -> 05 in order (or use the Collection Runner). Edit the environment values to change the data; no request needs editing.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "00 - Health Check",
			"item": [
				{
					"name": "Health check (no auth)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/{{healthPath}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{healthPath}}"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "01 - Match setup (ADMIN)",
			"item": [
				{
					"name": "Create match",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Optionally generate a fresh match id each run (set autoGenerateMatchId=false to use matchId as-is),",
									"// and a start time N hours ahead (betting is only open before the start time).",
									"const suffix = Date.now().toString(36).toUpperCase();",
									"if (pm.environment.get(\"autoGenerateMatchId\") !== \"false\") {",
									"    pm.environment.set(\"matchId\", (pm.environment.get(\"matchIdPrefix\") || \"BPL-\") + suffix);",
									"}",
									"const hrs = Number(pm.environment.get(\"startOffsetHours\") || 24);",
									"pm.environment.set(\"startTime\", new Date(Date.now() + hrs*3600*1000).toISOString().replace(/\\.\\d+Z$/, \"Z\"));",
									"pm.environment.set(\"idemKey\", \"pm-\" + suffix + \"-\" + Math.floor(Math.random()*1e6));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
									"",
									"pm.test(\"Match is SCHEDULED\", () => pm.expect(pm.response.json().status).to.eql(pm.environment.get(\"statusScheduled\")));",
									"pm.test(\"Location header present\", () => pm.response.to.have.header(\"Location\"));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "{{apiKeyHeader}}",
								"value": "{{adminKey}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{matchName}}\",\n  \"teams\": [\n    { \"teamId\": \"{{team1Id}}\", \"name\": \"{{team1Name}}\" },\n    { \"teamId\": \"{{team2Id}}\", \"name\": \"{{team2Name}}\" }\n  ],\n  \"startTime\": \"{{startTime}}\",\n  \"status\": \"{{statusScheduled}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/{{matchesPath}}/{{matchId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{matchesPath}}",
								"{{matchId}}"
							]
						},
						"description": "201 on first create. Re-sending the same PUT returns 200 (idempotent upsert). If autoGenerateMatchId=false and the match already exists as COMPLETED, this fails with 409."
					},
					"response": []
				},
				{
					"name": "Get match(matchId)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Same id\", () => pm.expect(pm.response.json().matchId).to.eql(pm.environment.get(\"matchId\")));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "{{apiKeyHeader}}",
								"value": "{{userKey1}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/{{matchesPath}}/{{matchId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{matchesPath}}",
								"{{matchId}}"
							]
						}
					},
					"response": []
				},
				{
					"name": "List matches",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
									"",
									"pm.test(\"Contains our match\", () => pm.expect(pm.response.json().map(m => m.matchId)).to.include(pm.environment.get(\"matchId\")));",
									"pm.test(\"X-Total-Count header\", () => pm.response.to.have.header(\"X-Total-Count\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "{{apiKeyHeader}}",
								"value": "{{userKey1}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/{{matchesPath}}?status={{statusScheduled}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{matchesPath}}"
							],
							"query": [
								{
									"key": "status",
									"value": "{{statusScheduled}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
